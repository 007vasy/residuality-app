# Copy to config.env and fill in, then: ./deploy/cloud-run/setup.sh
# (setup.sh sources ./deploy/cloud-run/config.env if it exists.)

# ---- Required: GCP target ----
PROJECT_ID=stressforge-prod          # your dedicated GCP project id
REGION=us-central1                   # Cloud Run + Artifact Registry region

# ---- Required: Neo4j Aura connection ----
# Create a free/paid instance at https://console.neo4j.io and copy its details.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# ---- Optional: secrets ----
# Leave blank to auto-generate ON FIRST DEPLOY ONLY. Re-running setup.sh reuses
# existing Secret Manager versions (does not rotate). Set a value only when you
# intentionally want to write a new version.
JWT_SECRET=                          # blank -> generate once if missing in Secret Manager
APP_ENCRYPTION_KEY=                  # blank -> generate once if missing (32 bytes hex); losing it makes stored BYOK keys unrecoverable

# ---- Optional: custom domain (blank -> use the generated *.run.app URL) ----
DOMAIN=                              # e.g. stressforge.example.com

# ---- Optional: OAuth (blank -> that provider's button is hidden) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- Optional: tuning ----
SERVICE=stressforge                  # Cloud Run service name
MIN_INSTANCES=0                      # 0 = scale-to-zero (cheapest). WebSocket live-collab is correct at max 1 instance.
MAX_INSTANCES=1                      # keep at 1 for correct in-memory WS broadcast; raise only with a shared pub/sub
DEFAULT_LLM_MODEL=claude-opus-4-8
