# Copy to config.env and fill in, then: ./deploy/cloud-run/setup.sh
# (setup.sh sources ./deploy/cloud-run/config.env if it exists.)
# Do not commit config.env — it is gitignored.

# ---- Required: GCP target ----
PROJECT_ID=stressforge-demo          # dedicated GCP project (not a shared prod project)
REGION=us-central1                   # Cloud Run + Artifact Registry region

# ---- Required: Neo4j Aura connection ----
# Free tier is enough for the public gallery: https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# ---- Optional: secrets ----
# Leave blank to auto-generate ON FIRST DEPLOY ONLY. Re-running setup.sh reuses
# existing Secret Manager versions (does not rotate). Set a value only when you
# intentionally want to write a new version.
JWT_SECRET=                          # blank -> generate once if missing in Secret Manager
APP_ENCRYPTION_KEY=                  # blank -> generate once if missing (32 bytes hex); losing it makes stored BYOK keys unrecoverable

# ---- Optional: custom domain (blank -> use the generated *.run.app URL) ----
DOMAIN=                              # e.g. demo.stressforge.example.com

# ---- Optional: OAuth (blank -> that provider's button is hidden) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- Cost-minimised demo defaults ----
SERVICE=stressforge
MIN_INSTANCES=0                      # scale-to-zero → ~$0 when idle (Aura Free also $0)
MAX_INSTANCES=1                      # required for correct in-memory WS + rate-limit store
# Prefer a cheaper default model label in the UI; users still pay with their own BYOK key.
DEFAULT_LLM_MODEL=claude-haiku-4-5
CPU=1
MEMORY=512Mi
CONCURRENCY=40                       # lower concurrency = fewer parallel heavy AI streams per instance
TIMEOUT=300                          # seconds; AI SSE can run a while
# CPU always allocated costs more — leave false (default throttling when idle).
CPU_ALWAYS_ALLOCATED=false

# ---- Abuse controls (public demo) ----
ALLOW_REGISTRATION=true              # set false for gallery-only (no new email accounts)
REGISTRATION_INVITE_CODE=            # if set, signup requires this code (share out-of-band)
MAX_PROJECTS_PER_USER=5              # cap owned projects per account
RATE_LIMIT_MAX=300                   # global req/IP/min
AUTH_RATE_LIMIT_MAX=20               # login/register/MCP req/IP/min
AI_RATE_LIMIT_MAX=10                 # AI SSE endpoints req/IP/min
