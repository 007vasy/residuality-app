# ---- Production env (copy to .env.prod and fill in) ----
# The public domain Caddy will obtain HTTPS certs for and the app is served at.
DOMAIN=stressforge.example.com

# ---- Neo4j (not exposed publicly in prod) ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password
NEO4J_AUTH=neo4j/change-me-strong-password

# ---- API secrets ----
# openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars
# openssl rand -hex 32   (must decode to 32 bytes)
APP_ENCRYPTION_KEY=change-me-64-hex-chars
DEFAULT_LLM_MODEL=claude-opus-4-8

# Seed the 14 public example projects on first boot (true/false)
SEED_EXAMPLES=true

# ---- OAuth (optional) ----
# Google: create an OAuth 2.0 Client (Web) in Google Cloud Console.
#   Authorized redirect URI: https://${DOMAIN}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter): create an OAuth 2.0 app in the X developer portal (Confidential client).
#   Callback URL: https://${DOMAIN}/api/auth/oauth/x/callback
#   Scopes: tweet.read users.read
X_CLIENT_ID=
X_CLIENT_SECRET=
